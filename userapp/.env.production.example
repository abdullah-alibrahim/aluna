# انسخي هذا الملف إلى .env ثم عبّي قيم الإنتاج قبل eas build --profile production
# مهم: المتاجر ترفض تطبيقات تتصل بـ localhost أو HTTP غير آمن للـ API في العادة — استخدمي HTTPS

EXPO_PUBLIC_API_URL=https://YOUR_API_DOMAIN/api
EXPO_PUBLIC_SOCKET_URL=https://YOUR_API_DOMAIN

# Firebase الحقيقي من Firebase Console (نفس المشروع المستخدم في google-services.json)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
