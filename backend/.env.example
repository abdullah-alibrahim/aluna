# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Database
MONGO_URI=mongodb://localhost:27017/salonapp
# Auto-seed on boot: only for USE_MEMORY_MONGO=1, or set AUTO_SEED=1 explicitly.
# Empty production DB will NOT auto-seed — run: npm run seed:syria
# USE_MEMORY_MONGO=1
# AUTO_SEED=1

# AI Features
GROQ_API_KEY=your_groq_api_key_here

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK (For Push Notifications & Auth)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin bootstrap — required to register an admin account from the admin app
ADMIN_INVITE_CODE=change-me-syria-admin-2026
