# API URL Configuration
# For local Android emulator testing, use your machine's local IP address (e.g., http://192.168.1.x:5000/api)
# For production, use your deployed backend URL (e.g., https://your-backend.com/api)
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api

# WebSocket URL Configuration
# Same rules apply as the API URL, but without the /api suffix
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.100:5000

# Firebase Client Configuration (For Web/Expo Auth fallback)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Syria: set backend PlatformSettings currency to ل.س / syp via npm run seed:syria
